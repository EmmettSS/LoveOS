# ---------------------------------------------------------------------------
# LoveOS — نمونه فایل محیط / environment sample
# کپی کنید به backend/.env و مقادیر را پر کنید.
# ---------------------------------------------------------------------------
# پروداکشن: False؛ برای توسعه‌ی محلی می‌توانی آن را True کنی.
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
ALLOWED_HOSTS=your-domain.example,www.your-domain.example
CSRF_TRUSTED_ORIGINS=https://*.e2b.app
# توسعه با proxy کار می‌کند؛ در تولید همان-origin است.
CORS_ALLOW_ALL=False
# اگر فرانت‌اند روی دامنه‌ای جداست، فقط همان originها را بنویس.
# CORS_ALLOWED_ORIGINS=https://app.example.com
TIME_ZONE=Asia/Tehran

# پنل بابا / secret admin
ADMIN_PATH=daddy-panel-9x7k
ADMIN_GATE_PASSCODE=

# دیتابیس: sqlite برای توسعه، mysql برای پروداکشن
DB_ENGINE=sqlite
DB_NAME=loveos.sqlite3
# DB_ENGINE=mysql
# DB_NAME=loveos
# DB_USER=loveos
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# سروش‌پلاس / Soroush Plus bot (https://api.splus.ir/bot<token>/METHOD)
NOTIFY_PROVIDER=console
SOROUSH_API_BASE=https://api.splus.ir
SOROUSH_TOKEN=
SOROUSH_DADDY_CHAT_ID=
SOROUSH_WEBHOOK_SECRET=loveos-hook
SOROUSH_PARSE_MODE=HTML

# نشست‌ها
SESSION_TTL_HOURS=720
VAULT_SESSION_MINUTES=20
MAX_UNLOCK_ATTEMPTS=5
API_RATE_LIMIT=300/min

# پشت پراکسی‌ای که خودش HTTPS را تمام می‌کند (Caddy/PaaS) False کن؛ وگرنه حلقه‌ی ریدایرکت
# Set False only behind a proxy that already redirects to HTTPS.
SECURE_SSL_REDIRECT=True

# سرو کردن فرانت‌اند توسط جنگو (برای cPanel/Passenger که فقط یک اپ دارند)
SERVE_FRONTEND=False
# FRONTEND_DIST=/home/USERNAME/loveos/frontend/dist
